{
  "name": "bad-apple-easter-egg",
  "version": "1.0.0",
  "description": "轻量零依赖的网页端 Bad Apple!! 彩蛋库：活体文字流变 60 FPS 汉字点阵与全息透明剪影双模态",
  "type": "module",
  "main": "./dist/bad-apple-easter-egg.umd.cjs",
  "module": "./dist/bad-apple-easter-egg.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "unpkg": "./dist/bad-apple-easter-egg.iife.js",
  "jsdelivr": "./dist/bad-apple-easter-egg.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bad-apple-easter-egg.js",
      "require": "./dist/bad-apple-easter-egg.umd.cjs"
    },
    "./iife": "./dist/bad-apple-easter-egg.iife.js",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview"
  },
  "keywords": [
    "bad-apple",
    "easter-egg",
    "canvas",
    "particle-system",
    "creative-coding",
    "text-matrix",
    "ascii-video",
    "fluid-dynamics",
    "touhou"
  ],
  "author": "eryuemu",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
